@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "_Layout";
}
<p class="alert alert-success">Bootstrap çalışıyor!</p>
<h2 class="my-4"> Kullanıcı Yönetimi</h2>

<table class="table table-hover table-bordered table-striped shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Email</th>
            <th>Kullanıcı Adı</th>
            <th class="text-center">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Select((u, i) => new { u, i }))
        {
            <tr>
                <td>@(user.i + 1)</td>
                <td>@user.u.Email</td>
                <td>@user.u.UserName</td>
                <td class="text-center">
                    <a asp-area="Admin" asp-controller="User" asp-action="Roles" asp-route-id="@user.u.Id" class="btn btn-sm btn-outline-primary me-1">
                        <i class="bi bi-shield-lock-fill"></i> Rolleri Düzenle
                    </a>
                    <form action="/Admin/User/Delete" method="post" style="display: inline;">
                        <input type="hidden" name="id" value="@user.u.Id" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu kullanıcıyı silmek istediğinizden emin misiniz?')">
                            <i class="bi bi-trash3-fill"></i> Sil
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
